# Leave empty in development so the client uses relative URLs and the Vite dev
# server proxies /api + /uploads to http://localhost:4000.
#
# Production (see .env.production, used automatically by `npm run build`):
#   VITE_API_BASE_URL=https://movie-worker.konkani-samudai.workers.dev
VITE_API_BASE_URL=

# Realtime is served by the Worker's Durable Object. Set this when the REST API is
# local but you still want live seat/catalog updates from the deployed Worker.
# Example: wss://movie-worker.konkani-samudai.workers.dev/api/v1/realtime
VITE_REALTIME_URL=
