# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/movie_booking

# API
API_PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
APP_BASE_URL=http://localhost:5175

# Payments (YouPI PG is bundled in this server; set to "mock" to bypass it)
PAYMENT_PROVIDER=youpi

# YOUPI PG (self-hosted UPI gateway) - https://github.com/youpi-pg/YouPI-PG
# The gateway is vendored into server/vendor/youpi-pg and runs INSIDE this server,
# so the whole app (movie API + UPI gateway + checkout page) is served on API_PORT.
YOUPI_ENABLED=true
# Internal loopback ports of the embedded gateway (not published, proxied internally)
YOUPI_GATEWAY_API_PORT=6100
YOUPI_GATEWAY_PORTAL_PORT=7000
# Prefix the checkout page uses for its own /api/v1 calls
YOUPI_CLIENT_API_BASE=/youpi
# Merchant admin panel (WhatsApp pairing QR, SMS gateway APK) at /youpi/admin
YOUPI_ADMIN_ENABLED=true
YOUPI_ADMIN_PORT=6001
# Local SMS observer (reads Google Messages in a browser, forwards bank SMS)
YOUPI_OBSERVER_ENABLED=false
YOUPI_OBSERVER_PORT=6002
# Gmail observer (official Google OAuth - reads bank credit emails)
# Create an OAuth client in Google Cloud Console > APIs & Services > Credentials
# (Web application, redirect URI = http://localhost:4000/youpi/gmail/oauth/callback)
YOUPI_GMAIL_PORT=6003
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Allow the gateway's admin API (token protected) through the public prefix
YOUPI_ALLOW_ADMIN=true
# Public origin of this server. Leave empty to derive it from the request host,
# which keeps localhost and LAN access (192.168.x.x:4000) working without a rebuild.
YOUPI_PUBLIC_BASE_URL=
# Public merchant id used by the browser SDK (the seeded default merchant)
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# Merchant secret, never exposed to the browser
YOUPI_MERCHANT_KEY=
# Shared secret used to sign/verify webhooks (HMAC-SHA256)
YOUPI_WEBHOOK_SECRET=change-me-youpi-webhook-secret
# Your real UPI VPA - the QR the customer scans
YOUPI_UPI_ID=
YOUPI_PAYEE_NAME=Konkani Samudai
# Origins allowed to embed the checkout page (comma separated). The client dev server is :5175.
YOUPI_FRAME_ANCESTORS=http://localhost:5175,http://192.168.0.150:5175
# Dev only: returns the OTP in the API response so the flow works without a paired
# WhatsApp number (the gateway refuses to send it when NODE_ENV=production).
YOUPI_EXPOSE_DEV_OTP=true
# Base URL for server-to-server calls to the payment core. It goes through this
# server's own public prefix, so the internal loopback port is never referenced.
YOUPI_API_URL=http://127.0.0.1:4000/youpi

# Email (logs only by default)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@movie.local

# Worker
WORKER_POLL_INTERVAL_MS=5000
HOLD_EXPIRY_SECONDS=600
MAX_SEATS_PER_BOOKING=10

# Supabase (optional; use as hosted Postgres/Auth/Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (optional; for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If using Supabase Postgres, set DATABASE_URL to the Supabase connection string (with SSL)

# Admin tokens
ADMIN_TOKEN=change-me-admin-token
ADMIN_API_TOKEN=
